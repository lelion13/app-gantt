# --- Copiar a .env y completar (no commitear .env) ---

# PostgreSQL (compose / local)
POSTGRES_DB=app_gantt
POSTGRES_USER=app_gantt
POSTGRES_PASSWORD=Cl4v3C0mpl3j4!#

# Backend: URL async/sync según implementación (Fase 2+)
DATABASE_URL=postgresql+psycopg://app_gantt:Cl4v3C0mpl3j4!#@localhost:5432/app_gantt

# JWT (access únicamente en MVP)
JWT_SECRET=change_me_use_long_random_string
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=60

# App
APP_TIMEZONE=America/Argentina/Buenos_Aires
# development | staging | production (documentación; en prod restringir CORS explícitamente)
APP_ENV=development
# Tamaño máximo aproximado del body (Content-Length) en bytes
HTTP_MAX_BODY_BYTES=524288
# Desactivar rate limit de login (solo tests / depuración)
# DISABLE_LOGIN_RATE_LIMIT=1
# Orígenes permitidos CORS (coma separada). En prod: https://gantt.lionapp.cloud
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primer admin (solo si la BD no tiene ningún admin; quitar en prod tras el primer arranque)
BOOTSTRAP_ADMIN_EMAIL=llion@cpmgsa.ar
BOOTSTRAP_ADMIN_PASSWORD=change_me_strong_password

# Imágenes GHCR / compose prod
IMAGE_TAG=latest

# Frontend build (Vite): base de la API (mismo host en prod suele ser /api o /api/v1)
VITE_API_BASE_URL=/api/v1

# --- Docker Compose (desarrollo) ---
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Objetivo del proxy de Vite hacia el backend (en compose se inyecta http://backend:8000)
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# --- Docker Compose producción (docker-compose.prod.yml) ---
GANTT_HOST=gantt.lionapp.cloud
# Sustituir TU_USUARIO_GITHUB (minúsculas en GHCR). Ejemplo tras CI: :sha o :latest
GHCR_BACKEND_IMAGE=ghcr.io/TU_USUARIO_GITHUB/app-gantt-backend:latest
GHCR_FRONTEND_IMAGE=ghcr.io/TU_USUARIO_GITHUB/app-gantt-frontend:latest
# En el VPS con compose, DATABASE_URL debe usar el hostname del servicio `db`, p. ej.:
# DATABASE_URL=postgresql+psycopg://app_gantt:change_me_in_prod@db:5432/app_gantt
